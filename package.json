{
  "name": "shopease",
  "version": "1.0.0",
  "description": "Full-stack e-commerce store: Node.js, Express, MySQL and a vanilla JS front end",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18.12" },
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "db:setup": "node server/scripts/setupDb.js",
    "db:reset": "node server/scripts/setupDb.js --reset",
    "db:admin": "node server/scripts/createAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13"
  }
}
